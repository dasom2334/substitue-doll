# 사용법: cp env.example .env  (필요 시 값 수정 — CLI 실행 시 자동 로드, 이미 export된 변수가 우선)

# 로컬 LLM (Ollama — docker compose up -d 로 기동)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Hugging Face Hub 접속 — 임베딩 "모델 파일" 다운로드용(대화 텍스트는 전송되지 않음)
#   0 = 온라인(기본): 최초 모델 다운로드·버전 확인을 HF에 요청. 익명이라
#       "unauthenticated requests" 경고가 뜰 수 있으나 무해(토큰 불필요).
#   1 = 오프라인: HF에 아예 접속하지 않음(경고도 사라짐). 단 모델이 이미
#       캐시(~/.cache/huggingface)된 뒤에만 켤 것 — 최초 실행 전에 켜면 다운로드 실패.
HF_HUB_OFFLINE=0
